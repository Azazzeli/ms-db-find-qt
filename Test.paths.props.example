<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Скопируйте в Test.paths.props и поправьте пути под свою машину. -->
  <PropertyGroup Label="Test.Paths">
    <NCadSdkRoot Condition="'$(NCadSdkRoot)'==''">D:\WORK\SAP\ncadsdk</NCadSdkRoot>
    <ModelStudioRoot Condition="'$(ModelStudioRoot)'==''">D:\WORK\SAP\Model Studio</ModelStudioRoot>
    <MsSourceDir>$(ModelStudioRoot)\Source</MsSourceDir>
    <MsCommonDir>$(ModelStudioRoot)\Common\Common_vc7</MsCommonDir>
    <MsApiDir>$(ModelStudioRoot)\API\ModelStudioAPI</MsApiDir>
    <MsApiDataDir>$(MsApiDir)\msData</MsApiDataDir>
    <NCadSdkInclude>$(NCadSdkRoot)\include</NCadSdkInclude>
    <NCadSdkIncludeX64>$(NCadSdkRoot)\include-x64</NCadSdkIncludeX64>
    <NCadSdkLibX64>$(NCadSdkRoot)\lib-x64</NCadSdkLibX64>
  </PropertyGroup>
</Project>
