#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
#pragma code_page(1252)

IDD_DBCONNECT DIALOGEX 0, 0, 340, 140
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Test - DB"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "",IDC_DB_STATIC_TITLE,12,10,316,12
    LTEXT           "",IDC_DB_LBL_STATUS,12,32,48,10
    LTEXT           "",IDC_DB_STATIC_STATUS,64,32,262,12
    LTEXT           "",IDC_DB_LBL_SERVER,12,52,48,10
    LTEXT           "",IDC_DB_STATIC_SERVER,64,52,262,12
    LTEXT           "",IDC_DB_LBL_DATABASE,12,72,48,10
    LTEXT           "",IDC_DB_STATIC_DATABASE,64,72,262,12
    LTEXT           "",IDC_DB_LBL_PLATFORM,12,92,48,10
    LTEXT           "",IDC_DB_STATIC_PLATFORM,64,92,262,12
    PUSHBUTTON      "Reconnect",IDC_DB_BTN_RECONNECT,12,112,100,18
    DEFPUSHBUTTON   "Close",IDCANCEL,260,112,68,18
END

IDD_DB_FIND DIALOGEX 0, 0, 560, 380
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Test - Find"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "",IDC_FIND_LBL_NAME,12,12,70,10
    EDITTEXT        IDC_FIND_EDIT_NAME,84,10,140,14,ES_AUTOHSCROLL
    LTEXT           "",IDC_FIND_LBL_PARAM,232,12,55,10
    COMBOBOX        IDC_FIND_CMB_PARAM,288,10,160,200,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_FIND_LBL_PVAL,456,12,20,10
    EDITTEXT        IDC_FIND_EDIT_PVAL,480,10,70,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Find",IDC_FIND_BTN_SEARCH,12,30,70,16
    LTEXT           "",IDC_FIND_STATIC_STATUS,90,32,458,12
    CONTROL         "",IDC_FIND_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,12,52,536,190
    EDITTEXT        IDC_FIND_EDIT_PARAMS,12,250,536,100,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "Close",IDCANCEL,480,356,68,18
END
